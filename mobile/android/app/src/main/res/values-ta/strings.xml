    <string name="notification_channel_name">முகவர்களின் செய்திகள்</string>
    <string name="notification_channel_description">ஒப்புதல்கள், கோப்புக் கோரிக்கைகள், உங்கள் முகவர்களுக்கு உங்களிடமிருந்து தேவைப்படும் பிற விஷயங்கள்</string>
    <string name="copied">நகலெடுக்கப்பட்டது</string>
    <string name="share_unreadable">Automa ஆல் அந்தக் கோப்பைப் படிக்க முடியவில்லை. வேறொரு ஆப்பிலிருந்து பகிருங்கள், அல்லது முதலில் ஃபோனில் சேமியுங்கள்.</string>
    <string name="offline_title">இணைப்பு இல்லை</string>
    <string name="offline_message">உங்கள் ஃபோன் ஆஃப்லைனில் உள்ளது. நெட்வொர்க் திரும்பியவுடன் Automa தானாகவே மீண்டும் இணையும்; பக்கத்தில் எதுவும் இழக்கப்படாது.</string>
    <string name="offline_waiting">நெட்வொர்க்குக்காகக் காத்திருக்கிறது…</string>
    <string name="unreachable_title">Automa ஐ அணுக முடியவில்லை</string>
    <string name="unreachable_message">சர்வர் பதிலளிக்கவில்லை. அது மறுதொடக்கம் ஆகிக்கொண்டிருக்கலாம், அல்லது ஃபோன் நெட்வொர்க்கை மாற்றியிருக்கலாம்.</string>
    <string name="offline_retry">இப்போது முயல்க</string>
